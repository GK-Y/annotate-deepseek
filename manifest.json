{
  "manifest_version": 3,
  "name": "Annotate for DeepSeek",
  "version": "0.1.0",
  "description": "Highlight text on DeepSeek Chat and drop it into the prompt box with one click.",
  "browser_specific_settings": {
    "gecko": {
      "id": "annotate-deepseek@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
